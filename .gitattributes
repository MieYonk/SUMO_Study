# Auto detect text files and perform LF normalization
* text=auto

# Git LFS: large simulation data files
*.net.xml filter=lfs diff=lfs merge=lfs -text
*.rou.xml filter=lfs diff=lfs merge=lfs -text
*.trips.xml filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.pbf filter=lfs diff=lfs merge=lfs -text
